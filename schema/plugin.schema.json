{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/2759069519/plugin-index/schema/plugin.schema.json",
  "title": "Plugin Index Entry",
  "description": "一条插件索引条目，跨生态通用。所有字段以插件自身的 manifest / README / 托管平台 API 为唯一事实来源，不做推测；取不到就写 null 或空数组。",
  "type": "object",
  "required": ["schemaVersion", "id", "ecosystem", "name", "summary", "repo", "category", "host", "install", "stats", "curatedAt"],
  "additionalProperties": false,
  "definitions": {
    "semverLike": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$" },
    "channelName": {
      "type": "string",
      "enum": ["npm", "pypi", "github", "marketplace", "release", "release-tarball", "script", "container", "local-dir"],
      "description": "分发渠道。marketplace 指各生态自有商店（VSCode Marketplace / Chrome Web Store / Obsidian 社区插件等）"
    }
  },
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0" },

    "id": {
      "type": "string",
      "description": "全局唯一：<ecosystem>:<插件自身标识>。插件有 manifest id 用它，没有则用 owner/repo。加生态前缀以免跨生态撞名。",
      "pattern": "^[a-z0-9-]+:[A-Za-z0-9_.@/-]+$"
    },

    "ecosystem": {
      "type": "string",
      "description": "所属插件生态。新生态先在此登记（见 docs/CATEGORY.md），避免同物异名。",
      "enum": [
        "dsh",
        "claude-code",
        "codex",
        "vscode",
        "chrome-extension",
        "obsidian",
        "raycast",
        "neovim",
        "mcp",
        "n8n",
        "figma",
        "blender",
        "browser-userscript",
        "other"
      ]
    },

    "name": { "type": "string", "description": "仓库名或包名" },
    "displayName": { "type": "string" },
    "summary": {
      "type": "string",
      "description": "中文一句话说明，列表与检索的唯一展示文案",
      "maxLength": 120
    },
    "summaryEn": { "type": "string" },
    "description": { "type": "string", "description": "展开说明，仅写 README 中的事实，<= 200 字" },

    "repo": { "type": "string", "pattern": "^https://(github\\.com|gitlab\\.com)/" },
    "homepage": { "type": ["string", "null"] },
    "author": { "type": "string" },

    "category": {
      "type": "array",
      "description": "功能分类（跨生态通用词汇），首个为主分类。用于筛选与聚合，不用于描述技术栈。",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "model-provider",
          "sidebar",
          "ui",
          "editor",
          "terminal",
          "workflow",
          "automation",
          "tool",
          "developer-tools",
          "media",
          "data",
          "knowledge",
          "search",
          "communication",
          "theme",
          "desktop",
          "integration",
          "security",
          "other"
        ]
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "license": { "type": ["string", "null"] },
    "language": { "type": ["string", "null"] },
    "version": { "$ref": "#/definitions/semverLike" },

    "host": {
      "type": "object",
      "description": "宿主与清单声明：这个插件装进什么、清单长什么样、要求什么宿主版本",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "宿主名称，如 DeepSeek Harness / Claude Code / VS Code" },
        "manifestPath": { "type": ["string", "null"], "description": "清单文件路径；null 表示仓库内未找到" },
        "manifestFormat": { "type": ["string", "null"], "description": "清单规范标识，如 dsh-plugin-0.15 / vscode-package-json / mcp-server-json" },
        "engines": {
          "type": "object",
          "description": "宿主版本约束，原样取自清单",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "install": {
      "type": "object",
      "required": ["preferred", "spec"],
      "additionalProperties": false,
      "properties": {
        "preferred": { "$ref": "#/definitions/channelName" },
        "spec": {
          "type": "string",
          "description": "唯一语义：被安装的目标（包名/仓库/文件/目录），不含任何命令前缀。供 AI 与其他工具直接消费。"
        },
        "command": { "type": ["string", "null"], "description": "完整可执行命令" },
        "commands": { "type": "array", "items": { "type": "string" }, "description": "多步命令，按顺序执行" },
        "forbidden": {
          "type": "array",
          "items": { "$ref": "#/definitions/channelName" },
          "description": "作者明确禁止的渠道"
        },
        "notes": { "type": "string" }
      }
    },

    "channels": {
      "type": "array",
      "description": "各分发渠道与该插件官方作品的关系判定（供应链信息，非质量评分）",
      "items": {
        "type": "object",
        "required": ["name", "trust"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/definitions/channelName" },
          "trust": {
            "type": "string",
            "enum": ["official", "forbidden", "third-party", "absent", "unknown"]
          },
          "url": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },

    "compat": {
      "type": "array",
      "description": "宿主版本 → 插件版本 pin 矩阵，取自 README 兼容表；plugin 为 none 表示无可用版本",
      "items": {
        "type": "object",
        "required": ["host", "plugin"],
        "additionalProperties": false,
        "properties": {
          "host": { "type": "string", "description": "宿主版本范围（原文语义）" },
          "plugin": { "type": "string" },
          "command": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },

    "stats": {
      "type": "object",
      "required": ["stars", "forks", "pushedAt"],
      "additionalProperties": false,
      "properties": {
        "stars": { "type": "integer", "minimum": 0 },
        "forks": { "type": "integer", "minimum": 0 },
        "openIssues": { "type": "integer", "minimum": 0 },
        "pushedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },

    "links": { "type": "object", "additionalProperties": { "type": "string" } },

    "ecosystemMeta": {
      "type": "object",
      "description": "生态特有字段的存放位（如 dsh 的 contributes、VSCode 的 activationEvents），避免污染通用字段",
      "additionalProperties": true
    },

    "featured": { "type": "boolean" },
    "curatedAt": { "type": "string", "format": "date" },
    "sources": { "type": "array", "items": { "type": "string" }, "description": "字段来源，便于复核" }
  }
}
