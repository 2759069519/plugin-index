{
  "schemaVersion": "2.0",
  "id": "dsh:dsh-external/dsh-better-sidebar",
  "ecosystem": "dsh",
  "name": "dsh-better-sidebar",
  "displayName": "Better Sidebar",
  "summary": "更好用的右侧边栏工作台：文件树、编辑器、终端、Git、侧边对话、子代理都收在这一栏，会话之间互不干扰。",
  "summaryEn": "A dual workbench for DSH: native right sidebar plus self-drawn bottom panel, with the ctx.betterSidebar service open to every plugin.",
  "description": "开放的侧边栏底座，向三方插件暴露 ctx.betterSidebar 服务，用于注册新侧边栏页面与文件预览器。内置文件渲染/编辑、终端、文件变动、任务、Git 面板与侧边对话，状态按会话存于 localStorage。单 npm 包：host 半身提供 /sidebar/api/* JSON API 与两条 WebSocket，client 半身渲染原生右栏与底部工作台。",
  "repo": "https://github.com/omdsh-dev/DSH-better-sidebar",
  "homepage": null,
  "author": "omdsh-dev (Oh My DSH)",
  "category": [
    "sidebar",
    "ui",
    "developer-tools"
  ],
  "tags": [
    "sidebar",
    "editor",
    "terminal",
    "git",
    "side-chat",
    "extension-host",
    "zh",
    "en"
  ],
  "license": "MIT",
  "language": "TypeScript",
  "version": "0.28.2",
  "host": {
    "name": "DeepSeek Harness",
    "manifestPath": "dsh.plugin.json",
    "manifestFormat": "dsh.plugin.json",
    "engines": {
      "dsh": ">=0.2.1-rc.1"
    }
  },
  "install": {
    "preferred": "npm",
    "spec": "dsh-better-sidebar@0.28.0",
    "command": "dsh plugin --profile web add dsh-better-sidebar@0.28.0",
    "commands": [
      "dsh plugin --profile web add dsh-better-sidebar@0.28.0",
      "硬刷新浏览器（Cmd/Ctrl+Shift+R）"
    ],
    "forbidden": [],
    "notes": "npm latest 随宿主版本前移，旧宿主务必按下方矩阵 pin 精确版本。也可让 DSH 自行安装（README 提供 prompt），或克隆仓库跑 scripts/install.sh <version>。"
  },
  "channels": [
    {
      "name": "npm",
      "trust": "official",
      "url": "https://www.npmjs.com/package/dsh-better-sidebar",
      "note": "README 直接引用该 npm 包的版本与下载量徽章，安装命令即 npm 包名"
    },
    {
      "name": "script",
      "trust": "official",
      "url": "https://github.com/omdsh-dev/DSH-better-sidebar/blob/main/scripts/install.sh",
      "note": "install.sh / install.ps1 处理安装 + bundle 注册"
    }
  ],
